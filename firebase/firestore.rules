rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && getUserData().role == 'administrator';
    }

    function isModerator() {
      return isSignedIn() && getUserData().role in ['moderator', 'administrator'];
    }

    function isActiveUser() {
      return isSignedIn() && getUserData().status == 'active';
    }

    function canReadVideo() {
      return resource.data.status == 'approved'
        || (isSignedIn() && resource.data.userId == request.auth.uid)
        || isModerator()
        || (resource.data.privacy == 'followers' && isSignedIn());
    }

    // Users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /watch_history/{videoId} {
        allow read, write: if isOwner(userId);
      }

      match /saved_videos/{videoId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Videos
    match /videos/{videoId} {
      allow read: if canReadVideo();
      allow create: if isActiveUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in ['pending', 'processing'];
      allow update: if (isOwner(resource.data.userId) && isActiveUser()) || isModerator();
      allow delete: if isOwner(resource.data.userId) || isModerator();
    }

    // Comments
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isActiveUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text.size() <= 500;
      allow update, delete: if isOwner(resource.data.userId) || isModerator();
    }

    // Follows
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isActiveUser()
        && request.resource.data.followerId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.followerId == request.auth.uid;
    }

    // Hashtags
    match /hashtags/{tagId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Reports
    match /reports/{reportId} {
      allow read: if isModerator();
      allow create: if isActiveUser();
      allow update: if isModerator();
    }

    // Moderation queue
    match /moderation_queue/{itemId} {
      allow read, write: if isModerator();
    }

    // Strikes
    match /strikes/{userId}/records/{strikeId} {
      allow read: if isOwner(userId) || isModerator();
      allow write: if isModerator();
    }

    // Daily content
    match /daily_content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Conversations & messages
    match /conversations/{conversationId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if isActiveUser()
        && request.auth.uid in request.resource.data.participantIds;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isActiveUser()
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn();
      }
    }

    // Live streams
    match /live_streams/{streamId} {
      allow read: if isSignedIn();
      allow create: if isActiveUser()
        && request.resource.data.hostId == request.auth.uid;
      allow update: if isOwner(resource.data.hostId) || isModerator();

      match /live_comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isActiveUser();
      }

      match /live_reactions/{reactionId} {
        allow read: if isSignedIn();
        allow create: if isActiveUser();
      }
    }

    // Drafts
    match /drafts/{draftId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isActiveUser()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }

    // Creator analytics
    match /creator_analytics/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // Monetization
    match /donations/{donationId} {
      allow read: if isSignedIn()
        && (resource.data.donorId == request.auth.uid
            || resource.data.creatorId == request.auth.uid);
      allow create: if isActiveUser()
        && request.resource.data.donorId == request.auth.uid;
    }

    match /subscriptions/{subId} {
      allow read: if isSignedIn()
        && (resource.data.subscriberId == request.auth.uid
            || resource.data.creatorId == request.auth.uid);
      allow create: if isActiveUser()
        && request.resource.data.subscriberId == request.auth.uid;
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
